{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "cat .env*": "deny",
      "cat *.env*": "deny",
      "type .env*": "deny",
      "more .env*": "deny",
      "Get-Content .env*": "deny",
      "Get-Content *.env*": "deny",
      "gc .env*": "deny",
      "gc *.env*": "deny"
    }
  }
}
